# Required
#
# This value must be a libpq-compatible URL for PostgreSQL client tools.
# Prefer NOT embedding the password here; use ~/.pgpass for cron-safe auth.
#
# Examples:
#   postgresql://crawl@localhost:5432/news_db
#   postgresql://crawl:crawl@localhost:5432/news_db
DATABASE_URL=postgresql://crawl@localhost:5432/news_db

# Where backups are stored (should be on the mounted “other disk”)
BACKUP_ROOT=/data/backups/news_db

# Retention
RETENTION_DAYS=14
RETENTION_WEEKS=8
RETENTION_MONTHS=12

# Logging
BACKUP_LOG_DIR=/data/backups/news_db/logs

# Optional: exclude schemas you don't need / don't have permissions for (comma-separated)
# Example (common when staging schemas exist): EXCLUDE_SCHEMAS=docker_stage
# EXCLUDE_SCHEMAS=
